# ========================
# PostgreSQL
# ========================
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=iot_platform

DATABASE_URL=postgresql+psycopg2://iot_user:your_secure_password@postgres:5432/iot_platform
DATABASE_URL_WORKER=postgresql://iot_user:your_secure_password@postgres:5432/iot_platform

# ========================
# Redis
# ========================
REDIS_URL=redis://redis:6379/0

# ========================
# MQTT
# ========================
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=iotuser
MQTT_PASSWORD=your_mqtt_password

# ========================
# API
# ========================
API_HOST=0.0.0.0
API_PORT=8000

API_ADMIN_USER=admin
API_ADMIN_PASSWORD=admin123

JWT_SECRET=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# ========================
# Dashboard (frontend)
# ========================
VITE_API_BASE=/api