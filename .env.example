# ========================
# PostgreSQL
# ========================
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=iot_platform

DATABASE_URL=postgresql+psycopg2://iot_user:your_secure_password@postgres:5432/iot_platform
DATABASE_URL_WORKER=postgresql://iot_user:your_secure_password@postgres:5432/iot_platform

# ========================
# Redis
# ========================
REDIS_URL=redis://redis:6379/0

# ========================
# MQTT
# ========================
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=iotuser
MQTT_PASSWORD=your_mqtt_password
# Identidad estable del worker de este broker; no compartir entre procesos.
MQTT_WORKER_CLIENT_ID=iot-vps-mqtt-worker

# ========================
# API
# ========================
API_HOST=0.0.0.0
API_PORT=8000
# Omite creación de esquema, SQL de startup y administrador inicial.
# Sólo afecta el arranque; los endpoints conservan sus escrituras normales.
API_STARTUP_READ_ONLY=false

API_ADMIN_USER=admin
API_ADMIN_PASSWORD=change-me

JWT_SECRET=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# ========================
# Dashboard (frontend)
# ========================
VITE_API_BASE=/api
VITE_TIME_ZONE=America/Argentina/Buenos_Aires

# Puertos del host VPS: siempre publicados en 127.0.0.1.
# No cambian los puertos internos ni MQTT_BROKER_PORT/API_PORT.
IOT_API_PORT=18000
IOT_DASHBOARD_PORT=18080
IOT_MQTT_PORT=1883
IOT_MQTT_WS_PORT=9001

# Integración con la app Control de Acceso (vacío = deshabilitada). Generar con:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ACCESS_INTEGRATION_API_KEY=
